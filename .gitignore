# ---------------------------------------------------------------
# MDSCevents
# Lock files (backend/uv.lock, frontend/package-lock.json) are
# intentionally committed for reproducible installs.
# ---------------------------------------------------------------

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Python (backend) ---
__pycache__/
*.py[oc]
*.egg-info/
.venv/
build/
wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Vite (frontend) ---
node_modules/
dist/
dist-ssr/
*.local
.vite/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini
